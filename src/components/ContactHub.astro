---
import { Calendar, Send, Mail, Phone, ExternalLink, ArrowRight, Sparkles } from 'lucide-astro';

const contactChannels = [
  {
    icon: Calendar,
    title: 'Agenda una Reunió',
    description: 'Reserva 30 minuts per videoconferència per parlar del teu projecte o iniciativa.',
    label: 'Obrir Google Calendar',
    href: 'https://calendar.app.google/YbQTidmXT3Bg9wdY8',
    isPrimary: true,
    isExternal: true
  },
  {
    icon: Send,
    title: 'Telegram Directe',
    description: 'Canal ràpid i àgil per consultes breus o coordinació de codi obert.',
    label: '@gabriel_rullan',
    href: 'https://t.me/gabriel_rullan',
    isPrimary: false,
    isExternal: true
  },
  {
    icon: Mail,
    title: 'Correu Electrònic',
    description: 'Bústia per a propostes ciutadanes, col·laboracions i consultoria.',
    label: 'gabriel@data-partner.xyz',
    href: 'mailto:gabriel@data-partner.xyz?subject=Proposta%20o%20consulta%20per%20a%20balears.tech',
    isPrimary: false,
    isExternal: false
  },
  {
    icon: Phone,
    title: 'Telèfon',
    description: 'Atenció telefònica directa per a qüestions urgents o institucionals.',
    label: '+34 638 95 26 23',
    href: 'tel:+34638952623',
    isPrimary: false,
    isExternal: false
  }
];
---

<section id="contacte" class="py-16 md:py-24 bg-gradient-to-b from-slate-50 to-white dark:from-slate-900/60 dark:to-surface-dark relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold bg-coral-100 text-coral-800 dark:bg-coral-950 dark:text-coral-300 border border-coral-200 dark:border-coral-800">
        <span>📬 Portes Obertes & Bústia Directa</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Xerrem sobre com la tecnologia pot impulsar el teu projecte o comunitat
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Tant si ets una associació cívica amb una proposta per a les illes, un desenvolupador que vol col·laborar en codi obert, com si representes una empresa amb un repte de dades, les nostres portes estan obertes.
      </p>
    </div>

    <!-- 4 Contact Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
      {contactChannels.map((channel) => {
        const Icon = channel.icon;
        return (
          <div class={`flex flex-col justify-between p-6 rounded-2xl border transition-all duration-300 hover:-translate-y-1 ${
            channel.isPrimary
              ? 'bg-gradient-to-b from-coral-50/70 to-white dark:from-coral-950/30 dark:to-surface-cardDark border-coral-300 dark:border-coral-700/60 shadow-md'
              : 'bg-white dark:bg-surface-cardDark border-slate-200/80 dark:border-slate-800 shadow-subtle hover:shadow-elevated'
          }`}>
            <div class="space-y-3">
              <div class={`inline-flex p-3 rounded-xl ${
                channel.isPrimary
                  ? 'bg-coral-500 text-white'
                  : 'bg-slate-100 dark:bg-slate-800 text-ocean-600 dark:text-ocean-400'
              }`}>
                <Icon class="w-6 h-6" />
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                {channel.title}
              </h3>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                {channel.description}
              </p>
            </div>

            <div class="pt-6 mt-4 border-t border-slate-100 dark:border-slate-800">
              <a
                href={channel.href}
                target={channel.isExternal ? '_blank' : undefined}
                rel={channel.isExternal ? 'noopener noreferrer' : undefined}
                class={`inline-flex items-center justify-between w-full px-3.5 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition-colors ${
                  channel.isPrimary
                    ? 'bg-coral-500 hover:bg-coral-600 text-white shadow-sm'
                    : 'bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200'
                }`}
              >
                <span class="truncate">{channel.label}</span>
                {channel.isExternal ? (
                  <ExternalLink class="w-3.5 h-3.5 shrink-0 ml-1.5" />
                ) : (
                  <ArrowRight class="w-3.5 h-3.5 shrink-0 ml-1.5" />
                )}
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Direct Citizen Proposal Box -->
    <div class="max-w-3xl mx-auto rounded-2xl bg-white dark:bg-surface-cardDark border border-slate-200/80 dark:border-slate-800 p-8 sm:p-10 shadow-elevated">
      <div class="space-y-4 text-center sm:text-left mb-8">
        <div class="flex items-center justify-center sm:justify-start gap-2 text-ocean-600 dark:text-ocean-400 text-xs font-bold uppercase tracking-wider">
          <Sparkles class="w-4 h-4" />
          <span>Bústia Ciutadana Directa</span>
        </div>
        <h3 class="text-2xl font-bold text-slate-900 dark:text-white">
          Fes-nos arribar la teva idea o proposta
        </h3>
        <p class="text-sm text-slate-600 dark:text-slate-300">
          Si representes una associació, tens una necessitat digital concreta o vols col·laborar en nous subdominis cívics, emplena aquest formulari i et respondrem directament.
        </p>
      </div>

      <form
        id="citizen-form"
        action="mailto:gabriel@data-partner.xyz"
        method="GET"
        enctype="text/plain"
        class="space-y-4"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="contact-name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
              Nom complet o entitat *
            </label>
            <input
              type="text"
              id="contact-name"
              name="nom"
              required
              placeholder="Ex: Associació de Joves de Palma"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-ocean-500 text-sm"
            />
          </div>
          <div>
            <label for="contact-email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
              Correu electrònic *
            </label>
            <input
              type="email"
              id="contact-email"
              name="email"
              required
              placeholder="correu@entitat.cat"
              class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-ocean-500 text-sm"
            />
          </div>
        </div>

        <div>
          <label for="contact-type" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
            Tipus de col·laboració
          </label>
          <select
            id="contact-type"
            name="tipus"
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-ocean-500 text-sm"
          >
            <option value="pro-bono">Suport Pro-bono per a entitat social o cultural</option>
            <option value="open-source">Col·laboració tècnica en codi obert</option>
            <option value="subdomini">Proposta de nou projecte / subdomini cívic (*.balears.tech)</option>
            <option value="empresa">Consulta professional / consultoria (data-partner.xyz)</option>
            <option value="altre">Altre suggeriment ciutadà</option>
          </select>
        </div>

        <div>
          <label for="contact-message" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1.5">
            Missatge o explicació de la iniciativa *
          </label>
          <textarea
            id="contact-message"
            name="missatge"
            rows="4"
            required
            placeholder="Explica'ns breument què necessites o quina idea t'agradaria impulsar..."
            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/60 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-ocean-500 text-sm leading-relaxed"
          ></textarea>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-slate-500 dark:text-slate-400 text-center sm:text-left">
            🔒 Tractem la informació amb confidencialitat i sense finalitats comercials.
          </p>
          <button
            type="submit"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl text-sm font-bold bg-ocean-600 hover:bg-ocean-700 text-white shadow-md transition-colors"
          >
            <Send class="w-4 h-4" />
            <span>Envia el teu missatge</span>
          </button>
        </div>
      </form>
    </div>

  </div>
</section>

<script>
  function setupContactForm() {
    const form = document.getElementById('citizen-form');
    if (!form) return;

    if (form.dataset.listenerAttached === 'true') return;
    form.dataset.listenerAttached = 'true';

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const nameInput = document.getElementById('contact-name') as HTMLInputElement | null;
      const emailInput = document.getElementById('contact-email') as HTMLInputElement | null;
      const typeSelect = document.getElementById('contact-type') as HTMLSelectElement | null;
      const msgTextarea = document.getElementById('contact-message') as HTMLTextAreaElement | null;

      const nom = nameInput ? nameInput.value : '';
      const email = emailInput ? emailInput.value : '';
      const tipus = typeSelect ? typeSelect.value : '';
      const missatge = msgTextarea ? msgTextarea.value : '';

      const subject = encodeURIComponent(`[balears.tech] Proposta: ${tipus} - ${nom}`);
      const body = encodeURIComponent(
        `Nom / Entitat: ${nom}\nCorreu: ${email}\nTipus: ${tipus}\n\nMissatge:\n${missatge}\n`
      );

      window.location.href = `mailto:gabriel@data-partner.xyz?subject=${subject}&body=${body}`;
    });
  }

  setupContactForm();
  document.addEventListener('astro:after-swap', setupContactForm);
</script>
