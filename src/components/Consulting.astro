---
import { Database, BarChart3, ShieldCheck, Users, ExternalLink, ArrowRight } from 'lucide-astro';

const services = [
  {
    icon: Database,
    title: 'Simplificació i Integració de Dades (Data Pipelines)',
    description:
      'Unificació de fonts disperses (ERPs, CRMs, APIs, fulls de càlcul), automatització de processos d\'ingesta i eliminació de tasques manuals repetitives.'
  },
  {
    icon: BarChart3,
    title: 'Business Intelligence & Dashboards Executius',
    description:
      'Quadres de comandament interactius i visuals (Power BI, Looker Studio, Metabase) adaptats a equips directius per prendre decisions basades en evidències reals.'
  },
  {
    icon: ShieldCheck,
    title: 'Auditoria Tecnològica i Optimització de Costos',
    description:
      'Diagnòstic d\'arquitectura al núvol per eliminar llicències innecessàries, reduir costos operatius i reforçar la seguretat i privacitat de les dades.'
  },
  {
    icon: Users,
    title: 'Oficina de Dades com a Servei (Data Partner)',
    description:
      'Direcció tècnica de dades flexible per a organitzacions que requereixen un lideratge sènior sense la càrrega de contractar un equip intern des del primer dia.'
  }
];
---

<section id="consultoria" class="py-16 md:py-24 border-t border-slate-200/80 dark:border-slate-800 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-800 dark:bg-slate-800 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
        <span>💼 Àrea de Consultoria Especialitzada · data-partner.xyz</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Acompanyament professional de dades i tecnologia per a empreses locals
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed">
        Molts negocis i pimes balears tenen dades disperses en fulls de càlcul o sistemes aïllats sense treure'n profit real. A través del nostre braç professional <strong class="font-bold text-slate-900 dark:text-white">data-partner.xyz</strong>, oferim consultoria especialitzada per a organitzacions que requereixen un servei corporatiu formal, estructurat i continuat.
      </p>
    </div>

    <!-- 4 Services Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mb-12">
      {services.map((service) => {
        const Icon = service.icon;
        return (
          <div class="p-6 sm:p-7 rounded-2xl bg-white dark:bg-surface-cardDark border border-slate-200/80 dark:border-slate-800 shadow-subtle hover:shadow-elevated transition-all duration-200">
            <div class="flex items-start gap-4">
              <div class="p-3 rounded-xl bg-ocean-50 dark:bg-ocean-950/70 border border-ocean-200 dark:border-ocean-800/80 text-ocean-600 dark:text-ocean-400 shrink-0">
                <Icon class="w-6 h-6" />
              </div>
              <div class="space-y-2">
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                  {service.title}
                </h3>
                <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                  {service.description}
                </p>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Complementary Banner with Image -->
    <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-ocean-900 via-slate-900 to-ocean-950 text-white p-8 md:p-10 shadow-elevated border border-ocean-800">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-8 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-ocean-800/80 text-teal-300 border border-ocean-700">
            <span>Complement Professional i Finançament Social</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
            Necessites un acompanyament empresarial a mida?
          </h3>
          <p class="text-sm sm:text-base text-slate-300 max-w-2xl leading-relaxed">
            La consultoria comercial es canalitza formalment a través de <strong class="text-white">data-partner.xyz</strong>. La nostra activitat professional finança i fa sostenible en el temps la capacitat d'oferir acompanyament gratuït i voluntari a entitats socials i associacions juvenils de les Balears.
          </p>
          <div class="pt-2 flex flex-wrap gap-4">
            <a
              href="https://data-partner.xyz/ca/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-sm font-bold bg-teal-500 hover:bg-teal-400 text-slate-950 shadow-md transition-colors"
            >
              <span>Descobreix els serveis a data-partner.xyz</span>
              <ExternalLink class="w-4 h-4" />
            </a>
            <a
              href="#contacte"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-sm font-semibold border border-slate-600 hover:bg-slate-800 text-white transition-colors"
            >
              <span>Xerrem del teu repte</span>
              <ArrowRight class="w-4 h-4" />
            </a>
          </div>
        </div>

        <div class="lg:col-span-4 hidden lg:block">
          <div class="relative rounded-xl overflow-hidden border border-slate-700 shadow-lg">
            <img
              src="/assets/img/consultoria.jpg"
              alt="Consultoria de Dades i Intel·ligència Empresarial per a empreses balears"
              width="400"
              height="280"
              class="w-full h-48 object-cover"
              loading="lazy"
            />
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
