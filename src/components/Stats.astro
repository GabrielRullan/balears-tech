---
const stats = [
  {
    value: '+13',
    label: "anys d'experiència corporativa",
    sublabel: 'AstraZeneca, MAPFRE, Boehringer, Movinga, APSL'
  },
  {
    value: '+65',
    label: 'rutes i acampades a escoltes',
    sublabel: 'Rutes, refugis i transports a escoltes.balears.tech'
  },
  {
    value: '+34.000',
    label: 'entrades al diccionari jisho',
    sublabel: 'JMdict & Cloud Run a jisho.balears.tech'
  },
  {
    value: '4',
    label: 'illes connectades',
    sublabel: 'Mallorca, Menorca, Eivissa i Formentera'
  }
];
---

<section class="py-12 bg-white dark:bg-surface-dark border-y border-slate-200/80 dark:border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
      {stats.map((item) => (
        <div class="text-center p-4 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-800/40 transition-colors">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-ocean-600 via-teal-600 to-coral-500 dark:from-ocean-400 dark:via-teal-300 dark:to-coral-400 tracking-tight">
            {item.value}
          </div>
          <div class="mt-2 text-sm sm:text-base font-bold text-slate-900 dark:text-white capitalize-first">
            {item.label}
          </div>
          <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">
            {item.sublabel}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
