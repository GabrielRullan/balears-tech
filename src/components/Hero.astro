---
import { ArrowRight, Compass, Heart, Sparkles, MapPin, CheckCircle2 } from 'lucide-astro';
---

<section id="inici" class="relative overflow-hidden pt-28 pb-16 md:pt-36 md:pb-24">
  <!-- Anchor alias for manifest -->
  <span id="manifest" class="sr-only">Manifest Cívic de balears.tech</span>

  <!-- Mediterranean ambient background glow -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] md:w-[900px] md:h-[450px] bg-gradient-to-tr from-ocean-500/15 via-teal-500/15 to-coral-500/10 blur-3xl -z-10 rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Manifesto & Narrative -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        
        <!-- Civic Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-ocean-100/90 text-ocean-800 dark:bg-ocean-950/80 dark:text-ocean-200 border border-ocean-200/80 dark:border-ocean-800/80 shadow-xs">
          <span class="inline-block animate-pulse">🌊</span>
          <span>Voluntariat Tecnològic · Impacte Cívic a les Illes Balears</span>
        </div>

        <!-- H1 Title -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.12]">
          Tecnologia oberta, dades i compromís comunitari per a les{' '}
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-ocean-600 via-teal-600 to-coral-500 dark:from-ocean-400 dark:via-teal-300 dark:to-coral-400">
            Illes Balears
          </span>
        </h1>

        <!-- Manifesto Subtitle -->
        <p class="text-base sm:text-lg lg:text-xl text-slate-600 dark:text-slate-300 leading-relaxed max-w-2xl mx-auto lg:mx-0">
          <strong class="font-bold text-slate-900 dark:text-white">balears.tech</strong> és una iniciativa cívica i independent creada per apropar la tecnologia d'alt nivell, les dades obertes i l'acompanyament digital a la societat balear. Posem l'experiència tècnica corporativa al servei d'associacions, iniciatives socials, joves i negocis locals de les nostres illes de forma altruista, col·laborativa i oberta.
        </p>

        <!-- Territorial Island Indicator -->
        <div class="inline-flex flex-wrap items-center justify-center lg:justify-start gap-2 pt-1 text-xs sm:text-sm font-medium text-slate-500 dark:text-slate-400">
          <span class="inline-flex items-center gap-1 text-ocean-700 dark:text-ocean-300 font-semibold">
            <MapPin class="w-3.5 h-3.5" />
            Illes Balears:
          </span>
          <span class="bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-md">Mallorca</span>
          <span>·</span>
          <span class="bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-md">Menorca</span>
          <span>·</span>
          <span class="bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-md">Eivissa</span>
          <span>·</span>
          <span class="bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-md">Formentera</span>
        </div>

        <!-- Action CTAs -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 sm:gap-4">
          <a
            href="#contacte"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-base font-bold bg-coral-500 hover:bg-coral-600 text-white shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5"
          >
            <span>Proposa una iniciativa cívica</span>
            <ArrowRight class="w-4 h-4" />
          </a>
          <a
            href="#projectes"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl text-base font-semibold border-2 border-ocean-500/80 hover:border-ocean-600 text-ocean-700 dark:text-ocean-300 hover:bg-ocean-50 dark:hover:bg-ocean-950/50 transition-all duration-200"
          >
            <Compass class="w-4 h-4 text-teal-600 dark:text-teal-400" />
            <span>Explora els projectes</span>
          </a>
        </div>

        <!-- Key Civic Guarantees -->
        <div class="pt-2 flex flex-wrap items-center justify-center lg:justify-start gap-4 text-xs text-slate-500 dark:text-slate-400">
          <div class="inline-flex items-center gap-1.5">
            <CheckCircle2 class="w-4 h-4 text-teal-600 dark:text-teal-400" />
            <span>100% Codi Obert & Lliure</span>
          </div>
          <div class="inline-flex items-center gap-1.5">
            <CheckCircle2 class="w-4 h-4 text-teal-600 dark:text-teal-400" />
            <span>Sense ànim de lucre cívic</span>
          </div>
          <div class="inline-flex items-center gap-1.5">
            <CheckCircle2 class="w-4 h-4 text-teal-600 dark:text-teal-400" />
            <span>Acompanyament humà i proper</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Composition with Hero Image -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Outer decorative border glow -->
          <div class="absolute -inset-1.5 bg-gradient-to-tr from-ocean-500 via-teal-500 to-coral-500 rounded-3xl opacity-30 dark:opacity-40 blur-md"></div>
          
          <!-- Image container -->
          <div class="relative overflow-hidden rounded-2xl border border-slate-200/80 dark:border-slate-700/80 bg-white dark:bg-surface-cardDark shadow-elevated">
            <img
              src="/assets/img/hero.jpg"
              alt="Paisatge mediterrani de les Illes Balears amb tecnologia i comunitat"
              width="600"
              height="450"
              class="w-full h-72 sm:h-80 md:h-96 object-cover"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>
            
            <!-- Bottom banner inside image -->
            <div class="absolute bottom-4 left-4 right-4 p-4 rounded-xl backdrop-blur-md bg-white/90 dark:bg-slate-900/90 border border-white/20 dark:border-slate-700/60 shadow-lg">
              <div class="flex items-center gap-3">
                <div class="p-2 rounded-lg bg-teal-500/20 text-teal-600 dark:text-teal-300">
                  <Sparkles class="w-5 h-5" />
                </div>
                <div>
                  <p class="text-xs font-semibold text-ocean-700 dark:text-ocean-300 uppercase tracking-wider">
                    Compromís Balear
                  </p>
                  <p class="text-sm font-bold text-slate-900 dark:text-white">
                    100% lliure, independent i fet des de les Illes
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
